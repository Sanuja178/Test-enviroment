# Copy this to .env.local and fill in your values.

# Admin password to access /admin (default: sesame)
ADMIN_PASSWORD=sesame

# Vercel KV (add via Vercel dashboard: Storage > Create > KV)
# These are auto-injected when you connect a KV store in the Vercel dashboard.
KV_REST_API_URL=
KV_REST_API_TOKEN=
